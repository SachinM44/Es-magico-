# Postgres connection string used by Prisma (server) and docker-compose.
# Host "postgres" works inside the compose network; use "localhost" when
# running the server directly on the host against the compose DB.
DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow?schema=public

# Express API port. Surfaced to the client via VITE_API_URL below.
PORT=4000

# Base URL the SPA uses for fetch calls. Vite inlines this at build time.
VITE_API_URL=http://localhost:4000
