commit_msg_file="$1"
commit_msg=$(head -n1 "$commit_msg_file")

pattern='^(feat|fix|chore|docs|refactor|test|build|ci|perf|style|revert)(\(.+\))?!?: .+'

if ! echo "$commit_msg" | grep -Eq "$pattern"; then
  echo "ERROR: Commit message does not follow Conventional Commits."
  echo "Expected: <type>(optional-scope)!: <subject>"
  echo "  type one of: feat, fix, chore, docs, refactor, test, build, ci, perf, style, revert"
  echo "Got: $commit_msg"
  exit 1
fi
